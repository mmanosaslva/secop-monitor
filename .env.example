# --- Motor (src/main.py) ---
# La interfaz web (src/web_server.py) solo usa DATABASE_URL, para LEER lo que
# registro el cron. Las demas son del motor.

DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
BREVO_API_KEY=your-brevo-api-key
SENDER_EMAIL=whoami_jay@proton.me
SENDER_NAME=SECOP Monitor
ADMIN_EMAIL=meriyei.manfer@gmail.com
STEALTH_MODE=false

# Opcional: token de datos.gov.co. Sin el la API funciona, pero con limite de
# peticiones mas bajo. Se obtiene en https://www.datos.gov.co (perfil > App Tokens).
SECOP_APP_TOKEN=

# --- Interfaz web (opcionales) ---
# Consulta publica de GitHub Actions. Sin token el limite es 60 consultas por
# hora, suficiente con la cache de 2 minutos; con un token de solo lectura
# (permiso actions:read) sube a 5000.
GITHUB_TOKEN=
# GITHUB_REPO=mmanosaslva/secop-monitor

# --- Pruebas ---
# Base para tests/test_main_integration.py. NUNCA la de produccion: esas
# pruebas corren el motor completo y escriben en ella.
TEST_DATABASE_URL=
